<%= render "shared/banner" %>

<div class="container my-5">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Mes listes</h1>
    <%= link_to "Ajouter une liste", new_list_path, class: "btn btn-primary" %>
  </div>

  <div class="row g-3">
    <% @lists.each do |list| %>
      <% image = list.photo.attached? ? cl_image_path(list.photo.key) : "https://picsum.photos/seed/#{list.id}/400/250" %>
      <div class="col-12 col-md-4">
        <%= link_to list_path(list), class: "text-decoration-none" do %>
          <div class="card-category" style="background-image: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.3)), url(<%= image %>)">
            <%= list.name %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
