<h1>Détail de la liste</h1>

<h2><%= @list.name %></h2>

<%= link_to "Ajouter un film à la liste", new_list_bookmark_path(@list) %>

<ul>
<% @list.movies.each do |movie| %>
  <% bookmark = Bookmark.find_by(list: @list, movie: movie) %>
  <li><%= movie.title %> -- <%= link_to "🗑️", bookmark_path(bookmark), data: { turbo_method: :delete, turbo_confirm: "sure ?"} %></li>
<% end %>
</ul>

<%= link_to "Retour aux listes", lists_path %>
