<% image = @list.photo.attached? ? cl_image_path(@list.photo.key) : "https://picsum.photos/seed/#{@list.id}/1200/400" %>

<div class="banner" style="background-image: linear-gradient(rgba(0,0,0,0.4),rgba(0,0,0,0.4)), url(<%= image %>);">
  <div class="container text-center">
    <h1><%= @list.name %></h1>
  </div>
</div>

<%= link_to "Ajouter un film à la liste", new_list_bookmark_path(@list) %>

<ul>
<% @list.movies.each do |movie| %>
  <% bookmark = Bookmark.find_by(list: @list, movie: movie) %>
  <li><%= movie.title %> -- <%= link_to "🗑️", bookmark_path(bookmark), data: { turbo_method: :delete, turbo_confirm: "sure ?"} %></li>
<% end %>
</ul>

<% @list.reviews.each do |review| %>
  <p><%= review.content %> -- Note : <%= review.rating %> / 5</p>
<% end %>

<%= link_to "Notez ma liste", new_list_review_path(@list) %>

<%= link_to "Retour aux listes", lists_path %>
